# Copy to `.env` next to deploy.sh. `deploy.sh` sources this file when present.
# Do not commit `.env` (gitignored).

# Home Assistant long-lived access token (Profile → Security).
HA_TOKEN=

# Pairing auth. Keep false for the demo so UI/Companion work without Bearer.
AUTH_REQUIRED=false
AUTH_SECRET=

# Hub Mongo (host network / instance bind).
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DATABASE=lan_iot

# Seed faker Xiaomi/Gree/ESP32 stubs when HA is down or for side-by-side demos.
SEED_FAKER_DEVICES=1

# Agent LLM. --llm=local|cloud|hybrid on deploy.sh also sets these.
LLM_PROVIDER=ollama
OLLAMA_URL=http://127.0.0.1:11434
LLM_MODEL=qwen2.5:7b
OPENAI_API_KEY=
LLM_FALLBACK_PROVIDER=

AGENT_URL=http://127.0.0.1:8000
HUB_URL=http://127.0.0.1:3000
HUB_MCP_URL=http://127.0.0.1:3000/mcp
TZ=UTC
