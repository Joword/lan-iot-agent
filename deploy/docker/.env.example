# Copy to `.env` next to docker-compose.yml (or export before `docker compose up`).
# Compose reads this file automatically when named `.env` in the same directory.

# Home Assistant long-lived access token (Profile → Security).
# Required for Hub device list / control against a real HA instance.
HA_TOKEN=

# Hub ↔ Agent wiring (defaults match Compose service DNS names).
AGENT_URL=http://agent:8000
HUB_URL=http://hub:3000
HUB_MCP_URL=http://hub:3000/mcp

# Pairing auth (P5). Default false so demos work without Bearer.
AUTH_REQUIRED=false
# Optional secret mixed into opaque tokens when minting.
AUTH_SECRET=
# Hub auth store (pairing codes + tokens). Compose service DNS: mongo.
MONGODB_URI=mongodb://mongo:27017
MONGODB_DATABASE=lan_iot

# Agent LLM (ollama profile: `docker compose --profile llm up`)
LLM_PROVIDER=ollama
OLLAMA_URL=http://ollama:11434

# Home Assistant timezone
TZ=UTC
